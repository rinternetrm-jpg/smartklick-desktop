{
  "name": "smartklick-desktop",
  "version": "2.10.0",
  "description": "Desktop Voice App mit KI-Korrektur",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "Smartklick",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.0",
    "electron-store": "^8.1.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^169.0.0",
    "openai": "^4.24.0",
    "sharp": "^0.33.0",
    "uuid": "^9.0.0",
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.smartklick.desktop",
    "productName": "Smartklick",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "python/**/*",
      "python-win/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "python-win",
        "to": "python-win",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "python-win/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icons/icon.png"
    }
  }
}
